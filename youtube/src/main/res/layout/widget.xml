<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/wThumb"
        android:layout_width="96dp"
        android:layout_height="54dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/wTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="DeLorean Tube"
            android:textColor="#FFF1F1F1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/wArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Nichts läuft gerade"
            android:textColor="#FFAAAAAA"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/wPrev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="Zurück"
        android:padding="8dp"
        android:src="@drawable/ic_skip_previous" />

    <ImageView
        android:id="@+id/wPlay"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="Play/Pause"
        android:padding="8dp"
        android:src="@drawable/ic_play" />

    <ImageView
        android:id="@+id/wNext"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="Weiter"
        android:padding="8dp"
        android:src="@drawable/ic_skip_next" />
</LinearLayout>
